# ── Database ──────────────────────────────────────────────────────────
# Default points at the bundled local PostgreSQL started by `npm run db:start`
# (no Docker needed). Replace with any PostgreSQL 14+ connection string.
DATABASE_URL="postgresql://vledger:vledger@localhost:5433/vledger?schema=public"
# Direct (non-pooled) connection for Prisma Migrate. Same as DATABASE_URL unless
# DATABASE_URL goes through a pooler such as PgBouncer.
DIRECT_DATABASE_URL="postgresql://vledger:vledger@localhost:5433/vledger?schema=public"
# Separate database used by the automated scenario tests (created automatically).
TEST_DATABASE_URL="postgresql://vledger:vledger@localhost:5433/vledger_test?schema=public"
LOCAL_PG_PORT=5433

# ── Application ───────────────────────────────────────────────────────
# Address used in email links (invitations, password resets). When people open
# the site from other devices, use that address, e.g. "http://192.168.1.20:3000".
APP_URL="http://localhost:3000"
# Session cookie Secure flag: "auto" follows the request protocol (https → Secure),
# which also lets plain http on a network address sign in. Set "true" behind a TLS
# proxy that does not send X-Forwarded-Proto.
COOKIE_SECURE="auto"
# 32-byte key, base64. Encrypts TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# ── Email (Brevo) ─────────────────────────────────────────────────────
# Keys stay on the server. Two transports are supported:
#   • Brevo Transactional API — set BREVO_API_KEY to an API key (starts with xkeysib-)
#   • Brevo SMTP relay        — set BREVO_API_KEY to an SMTP key (starts with xsmtpsib-)
#                               and BREVO_SMTP_LOGIN to your SMTP login (…@smtp-brevo.com)
# BREVO_SENDER_EMAIL must be a sender verified in your Brevo account.
# When email cannot be sent and EMAIL_DEV_OUTBOX=true, messages are kept in the
# Super Admin "Email outbox" so invitation links can be used during development.
BREVO_API_KEY=""
BREVO_SMTP_LOGIN=""
BREVO_SENDER_EMAIL="no-reply@example.com"
BREVO_SENDER_NAME="VLedger AI"
EMAIL_DEV_OUTBOX=true

# ── Scheduled jobs (optional) ─────────────────────────────────────────
# Enables POST /api/cron/summaries?period=daily|monthly (Authorization: Bearer <secret>)
# for hosted schedulers. Locally you can instead run `npm run summaries -- daily`.
CRON_SECRET=""

# ── AI provider (optional) ────────────────────────────────────────────
# none       → built-in rule-based parser only (no paid API needed)
# anthropic  → Claude via the Anthropic Messages API
# openai     → any OpenAI-compatible chat endpoint (e.g. Ollama: http://localhost:11434/v1)
AI_PROVIDER=none
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL=""

# ── Seed (development only) ───────────────────────────────────────────
SEED_SUPER_ADMIN_EMAIL="superadmin@vledger.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!2026"
SEED_DEMO_PASSWORD="Demo!2026pass"
