{
  "name": "vledger-ai",
  "version": "1.0.0",
  "private": true,
  "description": "VLedger AI — multi-workspace, AI-assisted double-entry accounting platform",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/local-postgres.ts start",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:scenarios": "vitest run tests/scenarios",
    "postinstall": "prisma generate",
    "dev:next": "next dev --turbopack -p 3000",
    "summaries": "tsx scripts/send-summaries.ts",
    "superadmin:reset": "tsx scripts/reset-super-admin.ts",
    "dev:webpack": "next dev -p 3000",
    "prod": "npm run build && npm start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.5.0",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.23.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
